+/* Diagnostic-only, opt-in private driver: the common submit worker discards
+ * error returns, so never continue rendering after an incomplete fence handoff.
+ * The session runner must restore stock libraries after this process exits.
+ */
+static void
+sync_fatal(const char *stage)
+{
+    fprintf(stderr, "ANLAND_KGSL_SYNC fatal=%s errno=%d\n", stage, errno);
+    abort();
+}
+
+static int
+shared_dmabuf(struct fd_bo *bo)
+{
+    struct kgsl_bo *kgsl_bo = to_kgsl_bo(bo);
+    if ((bo->alloc_flags & FD_BO_SHARED) && kgsl_bo->bo_type == KGSL_BO_IMPORT) {
+        if (kgsl_bo->import_fd < 0) {
+            errno = EBADF;
+            sync_fatal("shared-fd");
+        }
+        return kgsl_bo->import_fd;
+    }
+    return -1;
+}
+
+/* Ownership (DRI3/Wayland) must exclude conflicting use across this handoff.
+ * Export is a snapshot, not an inter-process reservation. Keep every submit's
+ * BO references alive through publication, including merged earlier submits.
+ * ponytail: conservatively serialize shared readers as RW; per-use masks can
+ * recover read parallelism only after correctness has been established.
+ */
+static unsigned
+import_dependencies(struct list_head *submits, int *in_fence)
+{
+    unsigned count = 0;
+    foreach_submit (submit, submits) {
+        struct fd_submit_sp *sp = to_fd_submit_sp(submit);
+        for (unsigned i = 0; i < sp->nr_bos; i++) {
+            int fd = shared_dmabuf(sp->bos[i]);
+            if (fd < 0)
+                continue;
+            struct dma_buf_export_sync_file dep = { .flags = DMA_BUF_SYNC_RW, .fd = -1 };
+            if (kgsl_pipe_safe_ioctl(fd, DMA_BUF_IOCTL_EXPORT_SYNC_FILE, &dep))
+                sync_fatal("export");
+            if (*in_fence < 0) {
+                *in_fence = dep.fd;
+            } else {
+                int merged = sync_merge("anland-kgsl", *in_fence, dep.fd);
+                if (merged < 0)
+                    sync_fatal("merge");
+                close(*in_fence);
+                close(dep.fd);
+                *in_fence = merged;
+            }
+            count++;
+        }
+    }
+    return count;
+}
+
+static void
+publish_completion(struct list_head *submits, int fence)
+{
+    foreach_submit (submit, submits) {
+        struct fd_submit_sp *sp = to_fd_submit_sp(submit);
+        for (unsigned i = 0; i < sp->nr_bos; i++) {
+            int fd = shared_dmabuf(sp->bos[i]);
+            if (fd < 0)
+                continue;
+            struct dma_buf_import_sync_file done = { .flags = DMA_BUF_SYNC_RW, .fd = fence };
+            if (kgsl_pipe_safe_ioctl(fd, DMA_BUF_IOCTL_IMPORT_SYNC_FILE, &done))
+                sync_fatal("publish");
+        }
+    }
+}
